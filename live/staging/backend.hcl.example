# Copy to backend.hcl (git-ignored) and run:
#   terraform init -backend-config=backend.hcl
# Values come from the bootstrap stack: terraform -chdir=bootstrap output backend_config
bucket         = "platform-tfstate-111111111111"
key            = "live/staging/terraform.tfstate"
region         = "eu-west-1"
encrypt        = true
kms_key_id     = "arn:aws:kms:eu-west-1:111111111111:key/REPLACE-ME"
dynamodb_table = "platform-tfstate-lock"
